<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StreakKeeper" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.StreakKeeper.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFF8F7</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_flame</item>
        <item name="postSplashScreenTheme">@style/Theme.StreakKeeper</item>
    </style>
</resources>
